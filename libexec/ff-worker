#!/usr/bin/env bash

set -uo pipefail

if (($# < 4)) || [[ $3 != -- ]]; then
  printf 'ff-worker: invalid invocation\n' >&2
  exit 64
fi

job_id=$1
display=$2
shift 3

format_duration() {
  local total=$1 hours minutes seconds
  hours=$((total / 3600))
  minutes=$(((total % 3600) / 60))
  seconds=$((total % 60))

  if ((hours > 0)); then
    printf '%dh %dm %ds' "$hours" "$minutes" "$seconds"
  elif ((minutes > 0)); then
    printf '%dm %ds' "$minutes" "$seconds"
  else
    printf '%ds' "$seconds"
  fi
}

send_notification() {
  local urgency=$1 headline=$2 body=$3

  [[ ${FF_NO_NOTIFY:-0} != 1 ]] || return 0

  if command -v omarchy >/dev/null 2>&1; then
    omarchy notification send --app-name ff --urgency "$urgency" "$headline" "$body" >/dev/null 2>&1 && return 0
  fi

  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=ff --urgency="$urgency" "$headline" "$body" >/dev/null 2>&1 || true
  fi
}

started_at=$(date +%s)
printf '[ff] job: %s\n' "$job_id"
printf '[ff] command: %s\n' "$display"
printf '[ff] started: %s\n' "$(date --iso-8601=seconds)"

"$@"
status=$?

finished_at=$(date +%s)
duration=$(format_duration "$((finished_at - started_at))")
printf '[ff] finished: %s\n' "$(date --iso-8601=seconds)"
printf '[ff] exit status: %d\n' "$status"
printf '[ff] duration: %s\n' "$duration"

notification_display=${display//$'\n'/ }
if ((${#notification_display} > 160)); then
  notification_display=${notification_display:0:157}...
fi

if ((status == 0)); then
  printf -v notification_body '%s\nFinished successfully in %s.' "$notification_display" "$duration"
  send_notification normal "ff completed" "$notification_body"
else
  printf -v notification_body '%s\nExit status %d after %s.' "$notification_display" "$status" "$duration"
  send_notification critical "ff failed" "$notification_body"
fi

exit "$status"
