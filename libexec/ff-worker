#!/usr/bin/env bash

set -uo pipefail

if (($# < 4)) || [[ $3 != -- ]]; then
  printf 'ff-worker: invalid invocation\n' >&2
  exit 64
fi

job_id=$1
display=$2
shift 3

log_pipe_dir=""
log_tee_pid=""

if [[ -n ${FF_LOG_FILE:-} ]]; then
  umask 077
  log_directory=$(dirname -- "$FF_LOG_FILE")
  mkdir -p -- "$log_directory"
  log_pipe_dir=$(mktemp -d --tmpdir="$log_directory" .ff-log-pipe.XXXXXX)
  mkfifo -- "$log_pipe_dir/output"
  tee -a -- "$FF_LOG_FILE" <"$log_pipe_dir/output" &
  log_tee_pid=$!
  exec >"$log_pipe_dir/output" 2>&1
fi

finish_logging() {
  [[ -n $log_tee_pid ]] || return 0
  exec 1>&- 2>&-
  wait "$log_tee_pid" || true
  unlink -- "$log_pipe_dir/output"
  rmdir -- "$log_pipe_dir"
}

format_duration() {
  local total=$1 hours minutes seconds
  hours=$((total / 3600))
  minutes=$(((total % 3600) / 60))
  seconds=$((total % 60))

  if ((hours > 0)); then
    printf '%dh %dm %ds' "$hours" "$minutes" "$seconds"
  elif ((minutes > 0)); then
    printf '%dm %ds' "$minutes" "$seconds"
  else
    printf '%ds' "$seconds"
  fi
}

send_notification() {
  local urgency=$1 headline=$2 body=$3
  local app_name=${FF_NOTIFY_APP:-ff}

  [[ ${FF_NO_NOTIFY:-0} != 1 ]] || return 0

  if command -v omarchy >/dev/null 2>&1; then
    omarchy notification send --app-name "$app_name" --urgency "$urgency" "$headline" "$body" >/dev/null 2>&1 && return 0
  fi

  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name="$app_name" --urgency="$urgency" "$headline" "$body" >/dev/null 2>&1 || true
  fi
}

started_at=$(date +%s)
printf '[ff] job: %s\n' "$job_id"
printf '[ff] command: %s\n' "$display"
printf '[ff] started: %s\n' "$(date --iso-8601=seconds)"

"$@"
status=$?

finished_at=$(date +%s)
duration=$(format_duration "$((finished_at - started_at))")
printf '[ff] finished: %s\n' "$(date --iso-8601=seconds)"
printf '[ff] exit status: %d\n' "$status"
printf '[ff] duration: %s\n' "$duration"

notification_display=${display//$'\n'/ }
if ((${#notification_display} > 160)); then
  notification_display=${notification_display:0:157}...
fi

if ((status == 0)); then
  printf -v notification_body '%s\nFinished successfully in %s.' "$notification_display" "$duration"
  send_notification normal "${FF_NOTIFY_APP:-ff} completed" "$notification_body"
else
  printf -v notification_body '%s\nExit status %d after %s.' "$notification_display" "$status" "$duration"
  send_notification critical "${FF_NOTIFY_APP:-ff} failed" "$notification_body"
fi

finish_logging
exit "$status"
